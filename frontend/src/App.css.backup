/* Colorful Employee Management System */

:root {
  font-family: "Segoe UI", Arial, sans-serif;
  color: #24304a;
  background: #f1f4ff;
}

body {
  margin: 0;
  min-height: 100vh;
  background: linear-gradient(135deg, #e0e7ff, #f5e9ff, #e0f7fa);
}

button {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: white;
  border: none;
  border-radius: 10px;
  padding: 10px 18px;
  font-weight: 600;
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s;
}

button:hover {
  transform: translateY(-2px);
  box-shadow: 0 5px 15px #6366f155;
}

input, select, textarea {
  border: 1px solid #d8def0;
  border-radius: 8px;
  padding: 10px 12px;
  background: white;
  font: inherit;
}

input:focus, select:focus, textarea:focus {
  outline: 2px solid #818cf8;
  border-color: #6366f1;
}

table {
  width: 100%;
  border-collapse: collapse;
  background: white;
  border-radius: 12px;
  overflow: hidden;
}

th {
  background: #4f46e5;
  color: white;
  text-align: left;
  padding: 14px;
}

td {
  padding: 13px 14px;
  border-bottom: 1px solid #edf0fa;
}

tr:hover td {
  background: #f3f0ff;
}

h1, h2, h3 {
  color: #3730a3;
}
